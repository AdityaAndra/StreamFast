# Copy this file to .env.local and fill in your key (https://www.themoviedb.org/settings/api).
# .env.local is git-ignored. On Vercel, set TMDB_API_KEY in Project Settings -> Environment Variables.
TMDB_API_KEY=

# Accounts + cloud sync (Supabase -> Project Settings -> API Keys). All optional: without them the
# site works as before and saves only in the browser.
# Public: exposed to the browser at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Secret (service role): only used by the serverless functions in api/. Never prefix it with VITE_.
SUPABASE_SECRET_KEY=
